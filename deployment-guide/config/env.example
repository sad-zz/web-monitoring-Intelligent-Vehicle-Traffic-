# ============================================
# TC Manager - Environment Template
# کپی به /opt/tc-manager/server/.env و مقادیر واقعی را وارد کنید
# ============================================

# Server
PORT=3000
HOST=0.0.0.0

# RMTO (OTF / RAHSAM) SOAP Web Service
RMTO_WSDL=http://otf.rmto.ir/Companies/Companies.asmx?WSDL
RMTO_ENDPOINT=http://otf.rmto.ir/Companies/Companies.asmx
RMTO_COMPANY_CODE=58
RMTO_USERNAME=CHANGE_ME
RMTO_PASSWORD=CHANGE_ME

# Data send interval (minutes)
SEND_INTERVAL_MINUTES=15

# Initial admin account (used only on first run to create the user)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Session secret (install.sh appends a random one automatically;
# set a fixed value here if creating .env manually)
# SESSION_SECRET=
