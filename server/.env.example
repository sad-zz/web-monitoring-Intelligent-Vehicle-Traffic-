# ============================================
# TC Manager Server Configuration
# ============================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================

# Database Type: 'sqlite' or 'postgresql'
# If DATABASE_URL is set, PostgreSQL is auto-detected
DATABASE_TYPE=sqlite

# PostgreSQL (for cloud deployment)
# Example: postgresql://user:password@host:5432/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tc_manager

# SQLite (default for local deployment)
# Database file location: server/data.db

# ============================================
# Authentication & Security
# ============================================

# Admin credentials (default)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Session secret (auto-generated if not set)
# SESSION_SECRET=your-random-secret-here

# Device API Key (for secure device data reception)
# Generate with: openssl rand -hex 32
DEVICE_API_KEY=

# ============================================
# RMTO (OTF) SOAP Web Service
# ============================================

RMTO_WSDL=http://otf.rmto.ir/Companies/Companies.asmx?WSDL
RMTO_ENDPOINT=http://otf.rmto.ir/Companies/Companies.asmx
RMTO_COMPANY_CODE=58
RMTO_USERNAME=NOGSH
RMTO_PASSWORD=CHANGE_ME_HERE

# Data send interval (minutes)
SEND_INTERVAL_MINUTES=15

# ============================================
# Device Data Reception
# ============================================

# Device webhook path (default: /api/data)
DEVICE_WEBHOOK_PATH=/api/data

# Rate limiting (requests per minute per device)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Backup & Restore
# ============================================

# Maximum backup file size (MB)
MAX_BACKUP_SIZE_MB=500

# Auto-import backup on first run
# AUTO_IMPORT_BACKUP=./backups/initial-backup.sql.gz

# ============================================
# Cloud Deployment Settings
# ============================================

# Railway.app, Render.com, Fly.io auto-detect DATABASE_URL
# Set these only if your provider doesn't auto-inject them

# Health check path (default: /health)
HEALTH_CHECK_PATH=/health

# Metrics path (default: /metrics)
METRICS_PATH=/metrics

# ============================================
# Logging
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable structured JSON logs (for cloud)
JSON_LOGS=false

