# ─── HTTP Server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ─── TCP Port (device connections) ───────────────────────────────────────────
TCP_PORT=2022

# ─── Admin Login ─────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=admin123
SESSION_SECRET=change_this_to_a_long_random_string

# ─── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Tehran

# ─── RMTO / RAHSAM Integration ────────────────────────────────────────────────
# آدرس WSDL سرویس RMTO
RMTO_WSDL=http://otf.rmto.ir/Companies/Companies.asmx?WSDL
# کد شرکت (پیش‌فرض: 58)
RMTO_COMPANY_CODE=58
# نام کاربری RAHSAM (شناسه کاربری)
RMTO_USERNAME=NOGSH
# کلمه عبور RAHSAM
RMTO_PASSWORD=CHANGE_ME_HERE

# ─── Scheduler ────────────────────────────────────────────────────────────────
# هر چند دقیقه یک‌بار رکوردهای pending به RMTO ارسال شوند
SEND_INTERVAL_MINUTES=5
