<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="SettingsField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- ورودی‌های آدرس/عدد/رمز باید چپ‌به‌راست باشند -->
    <style name="SettingsEditLtr">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">textUri|textNoSuggestions</item>
    </style>
</resources>
